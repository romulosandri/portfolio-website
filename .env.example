# Copy to .env and fill in -- `netlify dev` reads that file. Then add the same
# variables in Netlify under Site configuration -> Environment variables.
#
# PostHog project token is write-only / public and MUST use the VITE_ prefix so
# Vite can inline it into the client bundle. Resend keys must NOT use VITE_.
#
# Public address on the site is contact@romulosandri.com (copied on click).
# Form submissions are delivered to CONTACT_TO_EMAIL, not that public inbox.

# https://resend.com/api-keys -- a key with "Sending access" is enough.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend. Before the domain is
# verified you can use "onboarding@resend.dev", which only delivers to the
# address on your Resend account.
CONTACT_FROM_EMAIL="Portfolio <contact@romulosandri.com>"

# Private inbox for contact form submissions.
CONTACT_TO_EMAIL=romulosandrirodrigues@gmail.com

# PostHog product analytics (US Cloud). Token is public; set both locally and in Netlify.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
